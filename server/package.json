{
  "name": "insightboard-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix ../client",
    "dev:server": "nodemon src/server.js",
    "dev:client": "npm run dev --prefix ../client",
    "dev": "npm run setup && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "nodemon src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "nodemon": "^3.1.11",
    "sqlite3": "^5.1.7",
    "concurrently": "^8.2.0"
  }
}
